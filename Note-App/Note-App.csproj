<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Note_App</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

<!-- Pre-build step: ensure any running Note-App.exe processes are stopped so the build can overwrite the exe -->
<Target Name="KillRunningNoteApp" BeforeTargets="BeforeBuild">
  <Exec Command="powershell -NoProfile -Command &quot;try { Get-Process -Name 'Note-App' -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue } } catch { } ; exit 0&quot;" />
</Target>
</Project>
